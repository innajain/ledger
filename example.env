JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://postgres@localhost:5432/appdb
REDIS_URL=redis://localhost:6379
NEON_URL=prod_db_connection_string
CRON_SECRET=your_cron_secret_here
# Storage (S3-compatible — local MinIO in dev, Backblaze B2 / R2 / etc. in prod).
# Bucket is private; files are served via short-lived presigned GET URLs from the server.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=attachments
# Prod example (Backblaze B2):
# S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# S3_REGION=<region, e.g. us-west-004>
# S3_ACCESS_KEY_ID=<keyID>
# S3_SECRET_ACCESS_KEY=<applicationKey>
# S3_BUCKET=<bucket name>
