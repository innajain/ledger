JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://postgres@localhost:5432/appdb
REDIS_URL=redis://localhost:6379
CRON_SECRET=your_cron_secret_here
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_local_dev

# Dev
PROD_REDIS_URL=prod_redis_connection_string
PROD_DATABASE_URL=prod_db_connection_string
# Used by sync-db to copy prod Vercel Blob into the local emulator. Leave
# unset to skip blob sync.
PROD_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_prod
NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:3100/api/blob
PROFILING=off
# Set to `off` to silence the dev query toasts (DB / Redis per-query toasts
# in the bottom-right). No effect in production.
DEV_QUERY_TOASTS=off

# Runtime observability (optional locally; provisioned by the Vercel Sentry
# integration in deployed environments). SENTRY_AUTH_TOKEN is build-only and
# must never be exposed through a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SENTRY_DSN=https://public_key@example.ingest.sentry.io/project_id
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_build_only_sentry_auth_token

# Trace sampling, 0 to 1. Both default to 0.1 — the per-request numbers are
# stored in server_metric regardless, so a low rate costs no profiling detail.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave unset to disable push (sending becomes a no-op). NEXT_PUBLIC_ copy is
# read by the browser to subscribe.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Connector directories (Claude / ChatGPT). SUPPORT_EMAIL is the public contact
# on /privacy and /docs. OPENAI_APPS_CHALLENGE_TOKEN is the domain-verification
# token from the ChatGPT submission portal, served at
# /.well-known/openai-apps-challenge — leave unset except while submitting.
SUPPORT_EMAIL=support@example.com
# OPENAI_APPS_CHALLENGE_TOKEN=
