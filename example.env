JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://postgres@localhost:5432/appdb
REDIS_URL=redis://localhost:6379
CRON_SECRET=your_cron_secret_here
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_local_dev

# Dev
PROD_REDIS_URL=prod_redis_connection_string
PROD_DATABASE_URL=prod_db_connection_string
# Used by sync-db to copy prod Vercel Blob into the local emulator. Leave
# unset to skip blob sync.
PROD_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_prod
NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:3100/api/blob
PROFILING=off
# Set to `off` to silence the dev query toasts (DB / Redis per-query toasts
# in the bottom-right). No effect in production.
DEV_QUERY_TOASTS=off

# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave unset to disable push (sending becomes a no-op). NEXT_PUBLIC_ copy is
# read by the browser to subscribe.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
