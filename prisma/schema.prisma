generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String  @id @default(cuid())
  username      String  @unique
  password_hash String
  is_admin      Boolean @default(false)

  // Per-user defaults used when seeding new line items in the
  // transaction create/update pages. Plain ID columns (no Prisma
  // relation/FK) — ownership is validated in the server action and a
  // dangling reference falls back to the type-based default at render.
  default_account_id        String?
  default_allocation_id     String?
  default_income_expense_id String?
  default_asset_id          String?

  // The user's own UPI handle (e.g. "name@bank"). Set once by the user; any
  // account in another user's ledger that is linked to this user derives its
  // "Pay via UPI" target from here, so friends don't re-enter each other's VPAs.
  upi_id String?

  // UI preferences. Theme is 'light' | 'dark' | 'system' (validated in app code).
  theme           String  @default("system")
  masking_enabled Boolean @default(true)
  mask_threshold  Int     @default(50000)
  graphs_visible  Boolean @default(false)

  accounting_heads      accounting_head[]      @relation("HeadOwner")
  linked_from_heads     accounting_head[]      @relation("HeadLinkedUser")
  transactions          transaction[]
  transaction_templates transaction_template[]
  links_as_a            transaction_link[]     @relation("LinkUserA")
  links_as_b            transaction_link[]     @relation("LinkUserB")
  push_subscriptions    push_subscription[]
}

// A browser Web Push subscription for a user. One row per device/browser; a
// user may have several. `endpoint` is globally unique (it's the push service
// URL). Pruned when the push service reports it expired (404/410).
model push_subscription {
  id         String   @id @default(cuid())
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model accounting_head {
  id             String               @id @default(cuid())
  user_id        String
  name           String
  type           accounting_head_type
  is_active      Boolean              @default(true)
  is_placeholder Boolean              @default(false)
  order_index    Int?

  // --- Hierarchy Implementation ---
  parent_id String?
  parent    accounting_head?  @relation("AccountingHeadHierarchy", fields: [parent_id], references: [id])
  children  accounting_head[] @relation("AccountingHeadHierarchy")
  // --------------------------------

  // Optional cross-user link: when set, this account head "represents" another
  // user, so transactions touching it become approval-gated (see transaction_link).
  // Real FK (not a soft pointer) — it is load-bearing for approval routing.
  linked_user_id String?

  user           user                 @relation("HeadOwner", fields: [user_id], references: [id])
  linked_user    user?                @relation("HeadLinkedUser", fields: [linked_user_id], references: [id], onDelete: Restrict)
  line_items     line_item[]
  template_items line_item_template[]

  @@unique([name, user_id])
  @@index([user_id, type])
  @@index([parent_id])
  @@index([user_id, parent_id, order_index])
  @@index([user_id, linked_user_id])
}

model asset {
  // Assets are global (admin-managed), not user-scoped — so a transaction and
  // its cross-user mirror can reference the same asset_id. CRUD is gated on
  // require_admin in the server actions.
  id             String     @id @default(cuid())
  name           String     @unique
  type           asset_type
  ticker         String?
  is_active      Boolean    @default(true)
  is_placeholder Boolean    @default(false)
  order_index    Int?

  // --- Hierarchy Implementation ---
  parent_id String?
  parent    asset?  @relation("AssetHierarchy", fields: [parent_id], references: [id])
  children  asset[] @relation("AssetHierarchy")
  // --------------------------------

  line_items     line_item[]
  template_items line_item_template[]

  @@index([parent_id])
  @@index([parent_id, order_index])
}

model transaction_template {
  id      String @id @default(cuid())
  user_id String

  description String?

  user       user                 @relation(fields: [user_id], references: [id])
  line_items line_item_template[]

  @@index([user_id])
}

model line_item_template {
  id          String  @id @default(cuid())
  description String?

  transaction_template_id String
  transaction_template    transaction_template @relation(fields: [transaction_template_id], references: [id], onDelete: Cascade)

  accounting_head_id String
  accounting_head    accounting_head @relation(fields: [accounting_head_id], references: [id])

  asset_id String
  asset    asset  @relation(fields: [asset_id], references: [id])

  quantity   Decimal? @db.Decimal(14, 4)
  txn_value Decimal? @db.Decimal(14, 4)

  @@index([transaction_template_id])
  @@index([accounting_head_id])
  @@index([asset_id])
}

model transaction {
  id          String   @id @default(cuid())
  user_id     String
  datetime    DateTime
  description String?

  user        user                     @relation(fields: [user_id], references: [id])
  line_items  line_item[]
  attachments transaction_attachment[]
  txn_a_links transaction_link[]       @relation("txn_a_links")
  txn_b_links transaction_link[]       @relation("txn_b_links")

  @@index([user_id, datetime])
}

model transaction_attachment {
  id             String   @id @default(cuid())
  transaction_id String
  url            String
  pathname       String
  filename       String
  content_type   String?
  size           Int?
  created_at     DateTime @default(now())

  transaction transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
}

model line_item {
  id          String    @id @default(cuid())
  description String?
  datetime    DateTime?

  transaction_id String
  transaction    transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  accounting_head_id String
  accounting_head    accounting_head @relation(fields: [accounting_head_id], references: [id])

  asset_id String
  asset    asset  @relation(fields: [asset_id], references: [id])

  quantity   Decimal? @db.Decimal(14, 4)
  txn_value Decimal? @db.Decimal(14, 4)

  @@index([transaction_id])
  @@index([accounting_head_id])
  @@index([asset_id])
}

enum accounting_head_type {
  account
  income_expense
  allocation
}

enum asset_type {
  rupees
  mf
  etf
  shares
  other
}

enum pending_status {
  pending
  approved
  rejected
}

enum pending_kind {
  change
  deletion
}

// Cross-user approval link between two users' copies of a shared transaction.
// See docs/linked-accounts-plan.md. a/b are stable identity (a = original
// creator); `pending_by` always names whoever must take the next action.
model transaction_link {
  id String @id @default(cuid())

  user_a_id String // original creator (stable identity)
  user_b_id String // linked counterparty (stable identity)
  txn_a_id  String? // creator's copy; nullable — a side may delete its copy while the link lives on
  txn_b_id  String? // counterparty's copy; null until first approval

  pending_status pending_status @default(pending)
  pending_kind   pending_kind?
  pending_by     String? // user who must respond/resolve while not approved; null iff approved

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_a user         @relation("LinkUserA", fields: [user_a_id], references: [id], onDelete: Restrict)
  user_b user         @relation("LinkUserB", fields: [user_b_id], references: [id], onDelete: Restrict)
  txn_a  transaction? @relation("txn_a_links", fields: [txn_a_id], references: [id], onDelete: SetNull)
  txn_b  transaction? @relation("txn_b_links", fields: [txn_b_id], references: [id], onDelete: SetNull)

  @@unique([txn_a_id, user_b_id])
  @@index([pending_by, pending_status])
  @@index([user_a_id])
  @@index([user_b_id])
}

// One row per server-side page render. Acts as the parent for slow_query
// and web_vital rows via request_id (which equals server_metric.id).
model server_metric {
  id      String  @id @default(cuid())
  user_id String?
  route   String

  total_ms          Int
  db_query_count    Int @default(0)
  db_query_ms       Int @default(0)
  redis_hits        Int @default(0)
  redis_misses      Int @default(0)
  redis_ms          Int @default(0)
  external_count    Int @default(0)
  external_ms       Int @default(0)
  compute_ms        Int @default(0)

  created_at DateTime @default(now())

  slow_queries slow_query[]

  @@index([created_at])
  @@index([route, created_at])
}

model slow_query {
  id         String @id @default(cuid())
  request_id String

  model       String?
  action      String?
  duration_ms Int

  created_at DateTime @default(now())

  request server_metric @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([duration_ms])
  @@index([created_at])
}

model web_vital {
  id String @id @default(cuid())

  route String // concrete pathname from window.location.pathname

  // 'LCP' | 'INP' | 'FCP' | 'TTFB' | 'CLS'
  name  String
  value Float
  // 'good' | 'needs-improvement' | 'poor'
  rating String?

  navigation_type String?

  created_at DateTime @default(now())

  @@index([route, name, created_at])
  @@index([created_at])
}
