generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String  @id @default(cuid())
  username      String  @unique
  password_hash String
  is_admin      Boolean @default(false)

  accounts              account[]
  assets                asset[]
  transactions          transaction[]
  transaction_templates transaction_template[]
}

model account {
  id        String       @id @default(cuid())
  user_id   String
  name      String
  type      account_type
  is_active Boolean      @default(true)

  // --- Hierarchy Implementation ---
  parent_id String?
  parent    account?  @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children  account[] @relation("AccountHierarchy")
  // --------------------------------

  user           user                 @relation(fields: [user_id], references: [id])
  line_items     line_item[]
  template_items line_item_template[]

  @@unique([name, user_id])
  @@index([user_id, type])
  @@index([parent_id])
}

model asset {
  id        String     @id @default(cuid())
  user_id   String
  name      String
  type      asset_type
  ticker    String?
  is_active Boolean    @default(true)

  // --- Hierarchy Implementation ---
  parent_id String?
  parent    asset?  @relation("AssetHierarchy", fields: [parent_id], references: [id])
  children  asset[] @relation("AssetHierarchy")
  // --------------------------------

  user           user                 @relation(fields: [user_id], references: [id])
  line_items     line_item[]
  template_items line_item_template[]

  @@unique([name, user_id])
  @@index([user_id])
  @@index([parent_id])
}

model transaction_template {
  id      String @id @default(cuid())
  user_id String

  description String?

  user       user                 @relation(fields: [user_id], references: [id])
  line_items line_item_template[]

  @@index([user_id])
}

model line_item_template {
  id          String  @id @default(cuid())
  description String?

  transaction_template_id String
  transaction_template    transaction_template @relation(fields: [transaction_template_id], references: [id], onDelete: Cascade)

  account_id String
  account    account @relation(fields: [account_id], references: [id])

  asset_id String
  asset    asset  @relation(fields: [asset_id], references: [id])

  quantity   Decimal? @db.Decimal(14, 4)
  book_value Decimal? @db.Decimal(14, 4)

  @@index([transaction_template_id])
  @@index([account_id])
  @@index([asset_id])
}

model transaction {
  id          String   @id @default(cuid())
  user_id     String
  datetime    DateTime
  description String?

  user       user        @relation(fields: [user_id], references: [id])
  line_items line_item[]

  @@index([user_id])
  @@index([datetime])
}

model line_item {
  id          String    @id @default(cuid())
  description String?
  datetime    DateTime?

  transaction_id String
  transaction    transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  account_id String
  account    account @relation(fields: [account_id], references: [id])

  asset_id String
  asset    asset  @relation(fields: [asset_id], references: [id])

  quantity   Decimal? @db.Decimal(14, 4)
  book_value Decimal? @db.Decimal(14, 4)

  @@index([transaction_id])
  @@index([account_id])
  @@index([asset_id])
}

enum account_type {
  real
  nominal
  allocation
}

enum asset_type {
  rupees
  mf
  etf
  shares
  other
}
